--// FULL HIGHLIGHT SYSTEM (NPC + PLAYER + TURRET)

local targetFolder = workspace:WaitForChild("ZOMBIES"):WaitForChild("Enemy")
local turretFolder = workspace:WaitForChild("RobotsTurret")

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local processed = {}

local FAST_DAMAGE_THRESHOLD = 25

--================ NPC =================--

local function isEnemyNPC(model)
	if not model:IsA("Model") then return false end
	return string.lower(model.Name) == "enemynpc"
end

local function getHumanoid(model)
	return model:FindFirstChildOfClass("Humanoid")
end

-- NPC: xanh -> vàng -> đỏ
local function getNPCColor(percent)
	local green = Color3.fromRGB(0,255,0)
	local yellow = Color3.fromRGB(255,255,0)
	local red = Color3.fromRGB(255,0,0)

	if percent > 0.5 then
		return yellow:Lerp(green, (percent - 0.5) / 0.5)
	else
		return red:Lerp(yellow, percent / 0.5)
	end
end

local function applyHealthColorNPC(highlight, humanoid)
	local lastHealth = humanoid.Health

	local function update()
		local currentHealth = humanoid.Health
		local percent = math.clamp(currentHealth / humanoid.MaxHealth, 0, 1)

		local targetColor = getNPCColor(percent)

		local delta = lastHealth - currentHealth
		lastHealth = currentHealth

		local tweenTime = 0.25
		if delta >= humanoid.MaxHealth * 0.3 or delta > FAST_DAMAGE_THRESHOLD then
			tweenTime = 0.05
		end

		TweenService:Create(
			highlight,
			TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
			{FillColor = targetColor}
		):Play()
	end

	-- update bình thường
	update()
	humanoid:GetPropertyChangedSignal("Health"):Connect(update)

	-- 🔥 FIX QUAN TRỌNG: chết là ép đỏ ngay
	humanoid.Died:Connect(function()
		highlight.FillColor = Color3.fromRGB(255,0,0)
	end)
end

local function setupNPC(model)
	if processed[model] then return end
	if not isEnemyNPC(model) then return end

	local humanoid = getHumanoid(model)
	if not humanoid then return end

	processed[model] = true

	if not model:FindFirstChildOfClass("Highlight") then
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.fromRGB(0,255,0)
		hl.FillTransparency = 0.3
		hl.OutlineColor = Color3.fromRGB(255,255,255)
		hl.Adornee = model
		hl.Parent = model

		applyHealthColorNPC(hl, humanoid)
	end
end

--================ PLAYER =================--

local function getPlayerColor(percent)
	local blue = Color3.fromRGB(100,200,255)
	local purple = Color3.fromRGB(170,0,255)
	return purple:Lerp(blue, percent)
end

local function applyHealthColorPlayer(highlight, humanoid)
	local lastHealth = humanoid.Health

	local function update()
		local currentHealth = humanoid.Health
		local percent = math.clamp(currentHealth / humanoid.MaxHealth, 0, 1)

		local targetColor = getPlayerColor(percent)

		local delta = lastHealth - currentHealth
		lastHealth = currentHealth

		local tweenTime = 0.25
		if delta >= humanoid.MaxHealth * 0.3 or delta > FAST_DAMAGE_THRESHOLD then
			tweenTime = 0.05
		end

		TweenService:Create(
			highlight,
			TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
			{FillColor = targetColor}
		):Play()
	end

	update()
	humanoid:GetPropertyChangedSignal("Health"):Connect(update)

	-- chết → tím đậm luôn
	humanoid.Died:Connect(function()
		highlight.FillColor = Color3.fromRGB(170,0,255)
	end)
end

local function setupPlayer(player)
	if player == Players.LocalPlayer then return end

	local function onCharacter(char)
		task.spawn(function()
			local humanoid = char:WaitForChild("Humanoid", 5)
			if not humanoid then return end

			processed[char] = nil

			local hl = char:FindFirstChildOfClass("Highlight")
			if not hl then
				hl = Instance.new("Highlight")
				hl.FillColor = Color3.fromRGB(100,200,255)
				hl.FillTransparency = 0.3
				hl.OutlineColor = Color3.fromRGB(255,255,255)
				hl.Adornee = char
				hl.Parent = char
			end

			processed[char] = true

			applyHealthColorPlayer(hl, humanoid)

			humanoid.Died:Connect(function()
				processed[char] = nil
			end)
		end)
	end

	if player.Character then
		onCharacter(player.Character)
	end

	player.CharacterAdded:Connect(onCharacter)
end

--================ TURRET =================--

local function setupTurret(model)
	if not model:IsA("Model") then return end
	if processed[model] then return end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	processed[model] = true

	--================ HIGHLIGHT =================--
	local hl = model:FindFirstChildOfClass("Highlight")
	if not hl then
		hl = Instance.new("Highlight")
		hl.FillColor = Color3.fromRGB(255,255,0)
		hl.FillTransparency = 0.3
		hl.OutlineColor = Color3.fromRGB(255,255,255)
		hl.Adornee = model
		hl.Parent = model
	end

	--================ BILLBOARD GUI =================--
	local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
	if not head then return end

	local billboard = head:FindFirstChild("TurretHP")
	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "TurretHP"
		billboard.Size = UDim2.new(0,100,0,40)
		billboard.StudsOffset = Vector3.new(0,3,0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local text = Instance.new("TextLabel")
		text.Size = UDim2.new(1,0,1,0)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.fromRGB(255,255,0)
		text.TextStrokeTransparency = 0
		text.TextScaled = false -- tắt auto scale
text.TextSize = 14      -- chỉnh nhỏ (m có thể đổi 12, 10 tùy thích)
		text.Font = Enum.Font.GothamBold
		text.Parent = billboard
	end

	local textLabel = billboard:FindFirstChildOfClass("TextLabel")

	--================ UPDATE HP =================--
	local function update()
		if humanoid and humanoid.Health >= 0 then
			local percent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
			textLabel.Text = percent .. "%"
		end
	end

	update()
	humanoid:GetPropertyChangedSignal("Health"):Connect(update)
end

--================ INIT =================--

-- NPC scan
for _, obj in pairs(targetFolder:GetDescendants()) do
	if obj:IsA("Model") then
		setupNPC(obj)
	end
end

-- NPC update
targetFolder.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		setupNPC(obj)

		obj:GetPropertyChangedSignal("Name"):Connect(function()
			setupNPC(obj)
		end)

		obj.ChildAdded:Connect(function(child)
			if child:IsA("Humanoid") then
				setupNPC(obj)
			end
		end)
	end
end)

-- PLAYER init
for _, plr in pairs(Players:GetPlayers()) do
	setupPlayer(plr)
end

Players.PlayerAdded:Connect(function(plr)
	setupPlayer(plr)
end)

-- TURRET scan
for _, obj in pairs(turretFolder:GetDescendants()) do
	if obj:IsA("Model") then
		setupTurret(obj)
	end
end

-- TURRET update
turretFolder.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		setupTurret(obj)

		obj.ChildAdded:Connect(function(child)
			if child:IsA("Humanoid") then
				setupTurret(obj)
			end
		end)
	end
end)
